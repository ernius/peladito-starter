            "language": "javascript",
            "source": [
                "for (const experiment of globalThis.experiments) {\n    console.log(`Running experiment: ${experiment.question}`);\n    const payload = {\n        prompt: experiment.question,\n    }\n    const response = await fetch('http://localhost:3000/api/chat', {\n      method: 'POST',\n      headers: {\n        'Content-Type': 'application/json', // Inform server you are sending JSON\n        'API-Version': '1',\n        'Authorization': 'Bearer cambiame-por-un-secreto-largo' // Optional auth header\n      },\n      body: JSON.stringify(payload) // Convert object to JSON string\n    });\n    const result = await response.json();\n    console.log(`Experiment result: ${JSON.stringify(result)}`);\n}"
            ],
